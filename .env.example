# Copy this file to .env and fill in the keys you use.

# Optional: OpenAI. Websites are crawled with Crawl4AI and contacts are read
# straight from each site, so leads work without it. When set, one small model
# call per site also confirms the site matches the search and fills the
# business name / city / contact person. OPENAI_MODEL defaults to gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: Google Places (Maps) API key. Required only for the "Google Maps"
# lead source, which finds businesses that have no website. Enable the Places
# API and billing in Google Cloud Console, then paste the key here.
GOOGLE_MAPS_API_KEY=

# Optional: n8n webhook that receives each saved lead for automated outreach.
# Leave empty to disable.
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/lead-intake

# Shared secret n8n must send as "Authorization: Bearer <this>" when it POSTs
# conversation logs back to /api/conversations. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
INBOUND_WEBHOOK_SECRET=

# Optional: ERPNext. Normally you connect it from the dashboard's Integrations
# page (which overrides these). Set them here only for command-line scraper runs.
# Generate the key/secret in ERPNext: User → Settings → API Access → Generate Keys.
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# 1 = create each new lead in ERPNext; 1 = skip leads ERPNext already has.
ERPNEXT_SAVE_LEADS=1
ERPNEXT_SKIP_EXISTING=1

# Dashboard login (the /login page). Every page and API route needs it.
# Changing the password logs every browser out.
AUTH_USERNAME=admin
AUTH_PASSWORD=
