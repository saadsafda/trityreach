# Copy this file to .env and replace the placeholder with your OpenAI API key.
OPENAI_API_KEY=your_real_key_here

# Optional: Google Places (Maps) API key. Required only for the "Google Maps"
# lead source, which finds businesses that have no website. Enable the Places
# API and billing in Google Cloud Console, then paste the key here.
GOOGLE_MAPS_API_KEY=

# Optional: n8n webhook that receives each saved lead for automated outreach.
# Leave empty to disable.
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/lead-intake

# Shared secret n8n must send as "Authorization: Bearer <this>" when it POSTs
# conversation logs back to /api/conversations. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
INBOUND_WEBHOOK_SECRET=
